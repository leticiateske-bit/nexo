# NEXO — Career Intelligence · variáveis de ambiente
# Copie para .env.local e preencha apenas o que estiver disponível.
# Nada aqui é obrigatório para rodar o MVP: sem chaves, o app usa armazenamento local (navegador).
# NUNCA use o prefixo NEXT_PUBLIC_ para segredos — essas variáveis vão para o navegador.

# --- Persistência (Etapa 2) -------------------------------------------------
# Supabase: URL e chave anônima são públicas por natureza (protegidas por RLS).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: somente servidor (rotas /api). Nunca expor.
SUPABASE_SERVICE_ROLE_KEY=

# --- LinkedIn (API oficial, requer app aprovado em developer.linkedin.com) ---
# Produtos como "Sign In with LinkedIn using OpenID Connect" dão acesso apenas a
# nome/foto/e-mail. Métricas de perfil, SSI e posts exigem programas restritos
# (ex.: Community Management API) com aprovação da LinkedIn.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/integrations/linkedin/callback

# --- Vagas (fontes autorizadas via API) -------------------------------------
# Ex.: Adzuna (developer.adzuna.com) — possui endpoint para o Brasil (br).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- Notícias e tendências --------------------------------------------------
# Ex.: NewsAPI, GNews ou outro provedor com termos que permitam o uso.
NEWS_API_KEY=

# --- Geração de texto com IA (opcional) ------------------------------------
# Sem chave, o Estúdio de Conteúdo usa o gerador local por modelos.
ANTHROPIC_API_KEY=
